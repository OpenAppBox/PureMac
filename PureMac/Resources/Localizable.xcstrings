          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bare visning. Administrer bilder og volumer i Docker eller med `docker`-kommandoer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen bekijken. Beheer images en volumes in Docker of met `docker`-commando's."
          }
        },
        "pl" : {
          "stringUnit" : {
