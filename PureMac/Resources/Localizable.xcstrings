    "Leftovers of apps that are no longer installed — listed only when independent checks agree." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بقايا تطبيقات لم تعد مثبّتة — لا تُدرج إلا عندما تتفق فحوصات مستقلة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rester af apps, der ikke længere er installeret – vises kun, når uafhængige kontroller stemmer overens."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reste von Apps, die nicht mehr installiert sind – nur aufgeführt, wenn unabhängige Prüfungen übereinstimmen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enää asentamattomien appien jäänteet – näytetään vain, kun riippumattomat tarkistukset täsmäävät."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restes d’apps qui ne sont plus installées — listés uniquement quand des vérifications indépendantes concordent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
