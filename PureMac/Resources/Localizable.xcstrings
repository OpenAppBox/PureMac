    "Memory, CPU, temperature and disk space are all within normal ranges." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذاكرة والمعالج والحرارة ومساحة القرص كلها ضمن النطاقات الطبيعية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukommelse, CPU, temperatur og diskplads ligger alle inden for normale niveauer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsspeicher, CPU, Temperatur und Speicherplatz liegen alle im normalen Bereich."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muisti, suoritin, lämpötila ja levytila ovat kaikki normaaleissa rajoissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire, CPU, température et espace disque sont tous dans des plages normales."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria, CPU, temperatura e spazio su disco sono tutti nella norma."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモリ、CPU、温度、ディスクの空き容量はすべて正常範囲内です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모리, CPU, 온도, 디스크 공간이 모두 정상 범위입니다."
          }
        },
