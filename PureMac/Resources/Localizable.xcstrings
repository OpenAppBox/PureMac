    "Files changed in the last 7 days — useful for finding what suddenly used space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملفات التي تغيرت خلال آخر 7 أيام — مفيدة لمعرفة ما استهلك المساحة فجأة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer, der er ændret inden for de sidste 7 dage – nyttigt til at finde, hvad der pludselig brugte plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In den letzten 7 Tagen geänderte Dateien – hilfreich, um zu finden, was plötzlich Platz belegt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeisten 7 päivän aikana muuttuneet tiedostot – kätevä, kun etsit, mikä vei yhtäkkiä tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers modifiés ces 7 derniers jours — utile pour trouver ce qui occupe soudain de l’espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File modificati negli ultimi 7 giorni — utile per trovare cosa ha occupato spazio all’improvviso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去 7 日間に変更されたファイル — 急に容量を使い始めたものを探すのに役立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지난 7일 동안 변경된 파일 — 갑자기 공간을 차지한 항목을 찾는 데 유용합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som er endret de siste 7 dagene – nyttig for å finne hva som plutselig tok plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden die de afgelopen 7 dagen zijn gewijzigd – handig om te vinden wat plotseling ruimte gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki zmienione w ciągu ostatnich 7 dni — przydatne do znalezienia tego, co nagle zajęło miejsce."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos alterados nos últimos 7 dias — útil para descobrir o que ocupou espaço de repente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, изменённые за последние 7 дней, — удобно, чтобы найти, что внезапно заняло место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som ändrats de senaste 7 dagarna – praktiskt för att hitta vad som plötsligt tog plats."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son 7 günde değişen dosyalar — alanı aniden neyin kapladığını bulmak için kullanışlıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过去 7 天内更改的文件 — 有助于找出突然占用空间的内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去 7 天內變更的檔案 — 有助於找出突然佔用空間的內容。"
          }
        }
      }
    },
    "Files grouped by extension. Pick a type to see its largest files." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملفات مجمّعة حسب الامتداد. اختر نوعًا لرؤية أكبر ملفاته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer grupperet efter filtypenavn. Vælg en type for at se de største filer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien nach Erweiterung gruppiert. Wähle eine Art, um ihre größten Dateien zu sehen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiedostot päätteen mukaan ryhmiteltyinä. Valitse tyyppi nähdäksesi sen suurimmat tiedostot."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers regroupés par extension. Choisissez un type pour voir ses plus gros fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File raggruppati per estensione. Scegli un tipo per vederne i file più grandi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張子ごとにまとめたファイルです。種類を選ぶと、そのうち大きなファイルを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장자별로 묶은 파일입니다. 유형을 선택하면 가장 큰 파일을 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer gruppert etter filtype. Velg en type for å se de største filene."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden gegroepeerd per extensie. Kies een soort om de grootste bestanden ervan te zien."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki pogrupowane według rozszerzenia. Wybierz rodzaj, aby zobaczyć największe pliki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos agrupados por extensão. Escolha um tipo para ver os maiores arquivos dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы, сгруппированные по расширению. Выберите тип, чтобы увидеть самые крупные файлы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer grupperade efter filändelse. Välj en typ för att se dess största filer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzantıya göre gruplanmış dosyalar. En büyük dosyalarını görmek için bir tür seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按扩展名分组的文件。选择一种类型可查看其中最大的文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依副檔名分組的檔案。選擇一種類型可查看其中最大的檔案。"
          }
        }
      }
    },
    "Files of at least %@ not changed for over a year, largest first — often forgotten downloads, exports and disk images." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات لا يقل حجمها عن %@ ولم تتغير منذ أكثر من عام، الأكبر أولًا — غالبًا ما تكون تنزيلات وملفات مُصدَّرة وصور أقراص منسية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på mindst %@, der ikke er ændret i over et år, de største først – ofte glemte overførsler, eksporter og diskbilleder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien ab %@, die seit über einem Jahr nicht geändert wurden, die größten zuerst – oft vergessene Downloads, Exporte und Disk-Images."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähintään %@ tiedostot, joita ei ole muutettu yli vuoteen, suurimmat ensin – usein unohtuneita latauksia, vientejä ja levytiedostoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers d’au moins %@ non modifiés depuis plus d’un an, les plus gros d’abord — souvent des téléchargements, exports et images disque oubliés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File di almeno %@ non modificati da oltre un anno, i più grandi per primi — spesso download, esportazioni e immagini disco dimenticati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1 年以上変更されていない %@ 以上のファイル（大きい順）— 忘れられたダウンロード、書き出し、ディスクイメージであることが多いです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1년 넘게 변경되지 않은 %@ 이상의 파일(큰 순서) — 잊어버린 다운로드, 내보내기, 디스크 이미지인 경우가 많습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på minst %@ som ikke er endret på over ett år, de største først – ofte glemte nedlastinger, eksporter og diskbilder."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden vanaf %@ die meer dan een jaar niet zijn gewijzigd, de grootste eerst – vaak vergeten downloads, exports en schijfkopieën."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki od %@ niezmieniane od ponad roku, największe na początku — często zapomniane pobrane pliki, eksporty i obrazy dysków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos de pelo menos %@ sem alterações há mais de um ano, os maiores primeiro — muitas vezes downloads, exportações e imagens de disco esquecidos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы от %@, не менявшиеся больше года, сначала самые крупные, — часто это забытые загрузки, экспорты и образы дисков."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer på minst %@ som inte ändrats på över ett år, de största först – ofta bortglömda hämtningar, exporter och skivavbilder."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir yıldan uzun süredir değişmemiş, en az %@ boyutundaki dosyalar, en büyükten başlayarak — çoğu zaman unutulmuş indirmeler, dışa aktarımlar ve disk görüntüleri."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 %@ 且超过一年未更改的文件，从大到小 — 通常是被遗忘的下载、导出和磁盘映像。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 %@ 且超過一年未變更的檔案，由大到小 — 通常是被遺忘的下載項目、輸出檔和磁碟映像檔。"
          }
        }
      }
    },
