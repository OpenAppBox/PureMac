    "The tool downloads or rebuilds it the next time it’s needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيد الأداة تنزيله أو بناءه في المرة القادمة التي تحتاج إليه فيها."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Værktøjet henter eller opretter det igen, næste gang det skal bruges."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Werkzeug lädt oder erstellt es beim nächsten Bedarf neu."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Työkalu lataa tai luo sen uudelleen, kun sitä seuraavan kerran tarvitaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil le retélécharge ou le recrée la prochaine fois qu’il en a besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo strumento lo riscarica o lo ricrea la prossima volta che serve."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次に必要になったとき、ツールが再ダウンロードまたは再作成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다음에 필요할 때 도구가 다시 다운로드하거나 다시 빌드합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verktøyet laster ned eller lager det på nytt neste gang det trengs."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De tool downloadt of maakt het opnieuw aan zodra het weer nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzie pobierze lub odtworzy to przy następnej potrzebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
