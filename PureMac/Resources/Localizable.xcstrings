    "Choose “%@” so PureMac can measure it. Only names, sizes and dates are read." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «%@» حتى يتمكن PureMac من قياسه. لا تُقرأ إلا الأسماء والأحجام والتواريخ."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg „%@“, så PureMac kan måle den. Kun navne, størrelser og datoer læses."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „%@“, damit PureMac den Ordner messen kann. Es werden nur Namen, Größen und Daten gelesen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse ”%@”, jotta PureMac voi mitata sen. Vain nimet, koot ja päivämäärät luetaan."
