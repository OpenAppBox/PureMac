        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bara granskning. Hantera avbilder och volymer i Docker eller med `docker`-kommandon."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca inceleme. İmajları ve birimleri Docker’da ya da `docker` komutlarıyla yönetin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
