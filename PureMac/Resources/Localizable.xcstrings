          }
        }
      }
    },
    "Memory each process holds right now. Only processes your account may inspect are shown, and PureMac never quits processes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الذاكرة التي تحتفظ بها كل عملية الآن. لا تُعرض إلا العمليات التي يحق لحسابك فحصها، ولا ينهي PureMac أي عملية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hukommelse, som hver proces bruger lige nu. Kun processer, som din konto må undersøge, vises, og PureMac afslutter aldrig processer."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeitsspeicher, den jeder Prozess gerade belegt. Es werden nur Prozesse angezeigt, die dein Account prüfen darf, und PureMac beendet nie Prozesse."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunkin prosessin juuri nyt käyttämä muisti. Vain prosessit, joita tilisi saa tutkia, näytetään, eikä PureMac koskaan lopeta prosesseja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mémoire occupée actuellement par chaque processus. Seuls les processus que votre compte peut inspecter sont affichés, et PureMac ne quitte jamais de processus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memoria occupata ora da ogni processo. Vengono mostrati solo i processi che il tuo account può esaminare, e PureMac non chiude mai i processi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "各プロセスが現在使用しているメモリです。表示されるのはお使いのアカウントで調べられるプロセスのみで、PureMac がプロセスを終了することはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "각 프로세스가 현재 사용 중인 메모리입니다. 사용자 계정으로 검사할 수 있는 프로세스만 표시되며, PureMac은 프로세스를 종료하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minne som hver prosess bruker akkurat nå. Bare prosesser som kontoen din kan undersøke, vises, og PureMac avslutter aldri prosesser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geheugen dat elk proces nu gebruikt. Alleen processen die je account mag inspecteren worden getoond, en PureMac stopt nooit processen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięć, którą każdy proces zajmuje teraz. Pokazywane są tylko procesy, które Twoje konto może sprawdzić, a PureMac nigdy nie kończy procesów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memória que cada processo ocupa agora. Só são mostrados processos que sua conta pode inspecionar, e o PureMac nunca encerra processos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Память, которую каждый процесс занимает прямо сейчас. Показаны только процессы, доступные для проверки вашей учётной записью, и PureMac никогда не завершает процессы."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minne som varje process använder just nu. Bara processer som ditt konto får granska visas, och PureMac avslutar aldrig processer."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her işlemin şu anda tuttuğu bellek. Yalnızca hesabınızın inceleyebildiği işlemler gösterilir ve PureMac hiçbir zaman işlem sonlandırmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每个进程当前占用的内存。仅显示你的账户可以检查的进程，PureMac 从不退出进程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每個程序目前佔用的記憶體。僅顯示你的帳號可檢查的程序，PureMac 絕不結束程序。"
          }
        }
      }
    },
