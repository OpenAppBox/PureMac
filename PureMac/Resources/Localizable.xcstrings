            "value" : "Consultation seule. Gérez images et volumes dans Docker ou avec les commandes `docker`."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo consultazione. Gestisci immagini e volumi in Docker o con i comandi `docker`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
