    "None of the Xcode, simulator, package-manager, Docker or model-cache locations PureMac knows exist on this Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد على هذا الـ Mac أي من مواقع Xcode أو أجهزة المحاكاة أو مديري الحزم أو Docker أو ذاكرات النماذج المؤقتة التي يعرفها PureMac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingen af de Xcode-, simulator-, pakkehåndterings-, Docker- eller modelcachesteder, PureMac kender, findes på denne Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keiner der Xcode-, Simulator-, Paketmanager-, Docker- oder Modell-Cache-Orte, die PureMac kennt, ist auf diesem Mac vorhanden."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mitään PureMacin tuntemista Xcoden, simulaattorien, paketinhallinnan, Dockerin tai mallivälimuistin sijainneista ei ole tässä Macissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun des emplacements Xcode, simulateur, gestionnaire de paquets, Docker ou cache de modèles connus de PureMac n’existe sur ce Mac."
