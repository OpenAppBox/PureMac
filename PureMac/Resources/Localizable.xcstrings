    "Put Back is not available right now." : {
      "comment" : "Refers to the Put Back action that restores a trashed item, not the Undo action.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإرجاع غير متاح الآن."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg tilbage er ikke tilgængelig lige nu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zurücklegen ist gerade nicht verfügbar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Laita takaisin” ei ole juuri nyt käytettävissä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remettre en place n’est pas disponible pour le moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina non è disponibile al momento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在「戻す」は利用できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지금은 되돌려 놓기를 사용할 수 없습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg tilbake er ikke tilgjengelig akkurat nå."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terugzetten is nu niet beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przywracanie jest teraz niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar de Volta não está disponível agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возврат сейчас недоступен."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg tillbaka är inte tillgängligt just nu."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerine Koy şu anda kullanılamıyor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前无法使用“放回原处”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前無法使用「還原」。"
          }
        }
      }
    },
    "Put Back moves an item from the Trash to where it was, only if nothing else is there now and the Trash item is the same one PureMac moved." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينقل «إرجاع» عنصرًا من سلة المهملات إلى مكانه الأصلي، فقط إذا لم يكن هناك شيء آخر الآن وكان العنصر في سلة المهملات هو نفسه الذي نقله PureMac."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Læg tilbage flytter et emne fra papirkurven tilbage, hvor det var – kun hvis intet andet ligger der nu, og emnet i papirkurven er det samme, som PureMac flyttede."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Zurücklegen“ bringt ein Objekt aus dem Papierkorb an seinen Ort zurück – nur, wenn dort jetzt nichts anderes liegt und das Objekt im Papierkorb dasselbe ist, das PureMac verschoben hat."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "”Laita takaisin” siirtää kohteen roskakorista alkuperäiseen sijaintiin vain, jos siellä ei nyt ole mitään muuta ja roskakorin kohde on sama, jonka PureMac siirsi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remettre replace un élément de la Corbeille à son emplacement, seulement si rien d’autre ne s’y trouve et que l’élément de la Corbeille est bien celui que PureMac a déplacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ripristina riporta un elemento dal Cestino al suo posto, solo se lì ora non c’è nient’altro e l’elemento nel Cestino è lo stesso che PureMac ha spostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「戻す」は、元の場所にほかのものがなく、ゴミ箱の項目が PureMac が移動したものと同じ場合にのみ、項目を元の場所に戻します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“되돌려 놓기”는 원래 위치에 다른 항목이 없고 휴지통의 항목이 PureMac이 이동한 것과 같을 때만 항목을 원래 위치로 옮깁니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg tilbake flytter et objekt fra papirkurven dit det var, bare hvis ingenting annet ligger der nå og objektet i papirkurven er det samme som PureMac flyttet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "‘Zet terug’ zet een onderdeel uit de prullenmand terug op zijn plek, alleen als daar nu niets anders staat en het onderdeel in de prullenmand hetzelfde is dat PureMac heeft verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Przywróć z Kosza” przenosi element z powrotem na pierwotne miejsce — tylko jeśli nic innego tam teraz nie ma, a element w Koszu jest tym samym, który przeniósł PureMac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar de Volta move um item do Lixo para onde estava, só se não houver mais nada lá agora e se o item no Lixo for o mesmo que o PureMac moveu."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Восстановить» перемещает объект из Корзины на прежнее место, только если там сейчас ничего нет и объект в Корзине — тот самый, что переместил PureMac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg tillbaka flyttar ett objekt från papperskorgen dit det var, bara om inget annat finns där nu och objektet i papperskorgen är detsamma som PureMac flyttade."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yerine Koy, bir öğeyi yalnızca o konumda şu anda başka bir şey yoksa ve Çöp Sepetindeki öğe PureMac’in taşıdığıyla aynıysa eski yerine taşır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“放回原处”仅在原位置现在没有其他内容、且废纸篓中的项目正是 PureMac 移动的那个时，才会将项目移回原处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「還原」只會在原位置目前沒有其他內容、且垃圾桶中的項目正是 PureMac 搬移的那一個時，才將項目移回原位。"
          }
        }
      }
    },
