    "Fully offline: no account, no analytics, and file names or app lists never leave your Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دون اتصال تمامًا: لا حساب ولا تحليلات، ولا تغادر أسماء الملفات أو قوائم التطبيقات جهاز الـ Mac أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt offline: ingen konto, ingen analyse, og filnavne eller applister forlader aldrig din Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Komplett offline: kein Account, keine Analysen, und Dateinamen oder App-Listen verlassen nie deinen Mac."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Täysin offline: ei tiliä, ei analytiikkaa, eivätkä tiedostonimet tai appiluettelot koskaan poistu Macistasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entièrement hors ligne : pas de compte, pas d’analyses d’usage, et les noms de fichiers ou listes d’apps ne quittent jamais votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Completamente offline: nessun account, nessuna analisi d’uso, e nomi dei file o elenchi delle app non lasciano mai il tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全オフライン：アカウントも分析もなく、ファイル名やアプリの一覧が Mac の外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "완전 오프라인: 계정도 분석도 없으며, 파일 이름이나 앱 목록이 Mac 밖으로 나가지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt frakoblet: ingen konto, ingen analyse, og filnavn eller applister forlater aldri Macen din."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volledig offline: geen account, geen analyses, en bestandsnamen of applijsten verlaten nooit je Mac."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W pełni offline: bez konta, bez analityki, a nazwy plików i listy aplikacji nigdy nie opuszczają Twojego Maca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Totalmente offline: sem conta, sem análises de uso, e nomes de arquivos ou listas de apps nunca saem do seu Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Полностью офлайн: без учётной записи, без аналитики, а имена файлов и списки приложений никогда не покидают ваш Mac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Helt offline: inget konto, ingen analys, och filnamn eller applistor lämnar aldrig din dator."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamen çevrimdışı: hesap yok, analiz yok; dosya adları veya uygulama listeleri Mac’inizden asla çıkmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全离线：没有账户，没有分析，文件名或应用列表永远不会离开你的 Mac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完全離線：沒有帳號、沒有分析，檔案名稱或 App 列表絕不會離開你的 Mac。"
          }
        }
