    "PureMac has no notifications, login items or background activity. It only works while you use it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يملك PureMac إشعارات أو عناصر تسجيل دخول أو نشاطًا في الخلفية. يعمل فقط أثناء استخدامك له."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac har ingen meddelelser, login-emner eller baggrundsaktivitet. Den arbejder kun, mens du bruger den."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac hat keine Mitteilungen, Anmeldeobjekte oder Hintergrundaktivität. Es arbeitet nur, während du es nutzt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMacilla ei ole ilmoituksia, kirjautumiskohteita eikä taustatoimintaa. Se toimii vain, kun käytät sitä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac n’a ni notifications, ni éléments d’ouverture, ni activité en arrière-plan. Il ne fonctionne que pendant que vous l’utilisez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac non ha notifiche, elementi di login né attività in background. Funziona solo mentre lo usi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac には通知、ログイン項目、バックグラウンド処理がありません。使っている間だけ動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac에는 알림, 로그인 항목, 백그라운드 활동이 없습니다. 사용하는 동안에만 작동합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac har ingen varslinger, påloggingsobjekter eller bakgrunnsaktivitet. Den arbeider bare mens du bruker den."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac heeft geen meldingen, inlogonderdelen of achtergrondactiviteit. Het werkt alleen terwijl je het gebruikt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac nie ma powiadomień, rzeczy otwieranych po zalogowaniu ani aktywności w tle. Działa tylko wtedy, gdy go używasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O PureMac não tem notificações, itens de início nem atividade em segundo plano. Ele só funciona enquanto você o usa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У PureMac нет уведомлений, объектов входа и фоновой активности. Он работает, только пока вы им пользуетесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac har inga notiser, inloggningsobjekt eller bakgrundsaktivitet. Den arbetar bara medan du använder den."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac’in bildirimi, oturum açma öğesi veya arka plan etkinliği yoktur. Yalnızca siz kullanırken çalışır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac 没有通知、登录项或后台活动。它只在你使用时工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac 沒有通知、登入項目或背景活動。它只在你使用時運作。"
          }
        }
      }
    },
    "PureMac never empties the Trash for you." : {
