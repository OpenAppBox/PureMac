    "Another path points to the same data. Removing this path alone frees no space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشير مسار آخر إلى البيانات نفسها. إزالة هذا المسار وحده لا تحرر أي مساحة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En anden sti peger på de samme data. Hvis kun denne sti fjernes, frigøres der ingen plads."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein anderer Pfad verweist auf dieselben Daten. Wird nur dieser Pfad entfernt, wird kein Platz frei."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toinen polku osoittaa samoihin tietoihin. Pelkän tämän polun poistaminen ei vapauta tilaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un autre chemin pointe vers les mêmes données. Supprimer ce chemin seul ne libère aucun espace."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un altro percorso punta agli stessi dati. Rimuovere solo questo percorso non libera spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別のパスが同じデータを指しています。このパスだけを削除しても容量は解放されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 경로가 같은 데이터를 가리킵니다. 이 경로만 제거하면 공간이 확보되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annen bane peker til de samme dataene. Å fjerne bare denne banen frigjør ingen plass."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een ander pad verwijst naar dezelfde gegevens. Alleen dit pad verwijderen maakt geen ruimte vrij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inna ścieżka wskazuje na te same dane. Usunięcie tylko tej ścieżki nie zwalnia miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outro caminho aponta para os mesmos dados. Remover só este caminho não libera espaço."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На те же данные указывает другой путь. Удаление только этого пути не освобождает место."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En annan sökväg pekar på samma data. Att bara ta bort den här sökvägen frigör inget utrymme."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başka bir yol da aynı veriyi gösteriyor. Yalnızca bu yolu kaldırmak alan açmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一个路径指向相同的数据。仅移除此路径不会释放空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一個路徑指向相同的資料。僅移除此路徑不會釋放空間。"
          }
        }
      }
    },
