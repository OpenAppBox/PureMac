    "%lld items your apps and tools rebuild by themselves. Everything goes to the Trash first, and you see the full list before anything moves." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld عناصر تعيد تطبيقاتك وأدواتك إنشاءها بنفسها. ينتقل كل شيء إلى سلة المهملات أولًا، وترى القائمة كاملة قبل نقل أي شيء."
                }
              },
              "many" : {
                "stringUnit" : {
