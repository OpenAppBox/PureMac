        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS chroni Mail, Wiadomości, Safari i dane innych aplikacji. PureMac zgłasza je jako luki zamiast zgadywać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS protege Mail, Mensagens, Safari e dados de outros apps. O PureMac os informa como lacunas em vez de adivinhar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS защищает Почту, Сообщения, Safari и данные других приложений. PureMac отмечает их как пробелы, а не гадает."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS skyddar Mail, Meddelanden, Safari och andra appars data. PureMac rapporterar dem som luckor i stället för att gissa."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS; Mail, Mesajlar, Safari ve diğer uygulamaların verilerini korur. PureMac bunları tahmin etmek yerine boşluk olarak raporlar."
