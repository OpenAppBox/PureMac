          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araç, bir sonraki ihtiyaçta bunu yeniden indirir veya oluşturur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
