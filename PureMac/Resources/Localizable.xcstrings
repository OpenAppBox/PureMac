    "Low-risk package caches that tools download again when needed. Xcode data, archives, simulators and projects are never included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذاكرات تخزين مؤقت للحزم منخفضة المخاطر تعيد الأدوات تنزيلها عند الحاجة. لا تُضمَّن أبدًا بيانات Xcode أو الأرشيفات أو أجهزة المحاكاة أو المشاريع."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakkecaches med lav risiko, som værktøjer henter igen efter behov. Xcode-data, arkiver, simulatorer og projekter er aldrig med."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paket-Caches mit geringem Risiko, die Werkzeuge bei Bedarf neu laden. Xcode-Daten, Archive, Simulatoren und Projekte sind nie dabei."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vähäriskiset pakettivälimuistit, jotka työkalut lataavat tarvittaessa uudelleen. Xcode-dataa, arkistoja, simulaattoreita ja projekteja ei koskaan oteta mukaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches de paquets à faible risque que les outils retéléchargent au besoin. Les données Xcode, archives, simulateurs et projets ne sont jamais inclus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cache di pacchetti a basso rischio che gli strumenti riscaricano quando servono. Dati Xcode, archivi, simulatori e progetti non sono mai inclusi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "必要に応じてツールが再ダウンロードする低リスクのパッケージキャッシュです。Xcode のデータ、アーカイブ、シミュレータ、プロジェクトは含まれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "도구가 필요할 때 다시 다운로드하는 위험이 낮은 패키지 캐시입니다. Xcode 데이터, 아카이브, 시뮬레이터, 프로젝트는 포함되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakkebuffere med lav risiko som verktøy laster ned på nytt ved behov. Xcode-data, arkiver, simulatorer og prosjekter er aldri med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakketcaches met laag risico die tools opnieuw downloaden als dat nodig is. Xcode-gegevens, archieven, simulators en projecten horen er nooit bij."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pamięci podręczne pakietów o niskim ryzyku, które narzędzia pobierają ponownie w razie potrzeby. Dane Xcode, archiwa, symulatory i projekty nigdy nie są uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Caches de pacotes de baixo risco que as ferramentas baixam de novo quando precisam. Dados do Xcode, arquivos de build, simuladores e projetos nunca são incluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кэши пакетов с низким риском, которые инструменты загрузят снова при необходимости. Данные Xcode, архивы, симуляторы и проекты никогда не включаются."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paketcacheminnen med låg risk som verktyg hämtar igen vid behov. Xcode-data, arkiv, simulatorer och projekt ingår aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Araçların gerektiğinde yeniden indirdiği düşük riskli paket önbellekleri. Xcode verileri, arşivler, simülatörler ve projeler asla dahil edilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具会在需要时重新下载的低风险软件包缓存。Xcode 数据、归档、模拟器和项目永远不会包含在内。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "工具會在需要時重新下載的低風險套件快取。Xcode 資料、封存檔、模擬器和專案絕不會包含在內。"
          }
        }
      }
    },
