    "The biggest files anywhere in the scan. Select any you no longer need and press ⌘⌫ to review moving them to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكبر الملفات في أي مكان من الفحص. حدّد ما لم تعد بحاجة إليه واضغط ⌘⌫ لمراجعة نقله إلى سلة المهملات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De største filer i hele scanningen. Vælg dem, du ikke længere har brug for, og tryk på ⌘⌫ for at gennemgå flytningen til papirkurven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die größten Dateien im gesamten Scan. Wähle, was du nicht mehr brauchst, und drücke ⌘⌫, um das Verschieben in den Papierkorb zu prüfen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koko skannauksen suurimmat tiedostot. Valitse ne, joita et enää tarvitse, ja tarkista niiden siirto roskakoriin painamalla ⌘⌫."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les plus gros fichiers de toute l’analyse. Sélectionnez ceux dont vous n’avez plus besoin et appuyez sur ⌘⌫ pour vérifier leur placement dans la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file più grandi di tutta l’analisi. Seleziona quelli che non ti servono più e premi ⌘⌫ per controllarne lo spostamento nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャン全体で最も大きなファイルです。不要なものを選んで ⌘⌫ を押すと、ゴミ箱への移動を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 전체에서 가장 큰 파일입니다. 더 이상 필요 없는 파일을 선택하고 ⌘⌫를 눌러 휴지통으로 이동할 항목을 검토하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De største filene i hele skanningen. Velg dem du ikke lenger trenger, og trykk på ⌘⌫ for å gå gjennom flyttingen til papirkurven."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De grootste bestanden in de hele scan. Selecteer wat je niet meer nodig hebt en druk op ⌘⌫ om het verplaatsen naar de prullenmand te controleren."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Największe pliki w całym skanie. Zaznacz niepotrzebne i naciśnij ⌘⌫, aby sprawdzić ich przeniesienie do kosza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os maiores arquivos de toda a análise. Selecione os que não precisa mais e pressione ⌘⌫ para revisar a mudança para o Lixo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Самые крупные файлы во всём сканировании. Выберите ненужные и нажмите ⌘⌫, чтобы проверить их перемещение в Корзину."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De största filerna i hela skanningen. Markera dem du inte längre behöver och tryck på ⌘⌫ för att granska flytten till papperskorgen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taramanın her yerindeki en büyük dosyalar. Artık ihtiyaç duymadıklarınızı seçin ve Çöp Sepetine taşımayı incelemek için ⌘⌫ tuşlarına basın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整个扫描中最大的文件。选择不再需要的文件并按 ⌘⌫，检查是否将其移到废纸篓。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "整個掃描中最大的檔案。選取不再需要的檔案並按 ⌘⌫，檢查是否將其移到垃圾桶。"
          }
        }
      }
    },
