    "Wired" : {
      "comment" : "Memory statistic: wired memory is RAM that macOS keeps resident and cannot swap out. Not a network connection.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثابتة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fest belegt"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiinteä"
          }
        },
        "fr" : {
