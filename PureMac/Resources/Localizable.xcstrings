        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔 또는 정리가 끝날 때까지 기다리십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent til skanningen eller ryddingen er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wacht tot de scan of opschoonactie klaar is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj na zakończenie skanowania lub czyszczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde a análise ou a limpeza terminar."
          }
