    "Move this app’s %@ to the Trash and keep the app. They are recreated when needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقل %@ الخاص بهذا التطبيق إلى سلة المهملات مع الإبقاء على التطبيق. يُعاد إنشاؤه عند الحاجة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyt appens %@ til papirkurven, og behold appen. De oprettes igen efter behov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die %@ dieser App in den Papierkorb legen und die App behalten. Sie werden bei Bedarf neu angelegt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siirrä tämän apin kohde %@ roskakoriin ja säilytä appi. Ne luodaan tarvittaessa uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placer les %@ de cette app dans la Corbeille et garder l’app. Ils sont recréés au besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta i %@ di questa app nel Cestino e tieni l’app. Vengono ricreati quando servono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このアプリの %@ をゴミ箱に入れ、アプリは残します。必要に応じて再作成されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 앱의 %@을(를) 휴지통으로 이동하고 앱은 유지합니다. 필요할 때 다시 만들어집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytt appens %@ til papirkurven og behold appen. De lages på nytt ved behov."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaats de %@ van deze app naar de prullenmand en bewaar de app. Ze worden opnieuw aangemaakt als dat nodig is."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenieś %@ tej aplikacji do kosza i zachowaj aplikację. W razie potrzeby zostaną odtworzone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mover os %@ deste app para o Lixo e manter o app. Eles são recriados quando necessário."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переместить %@ этого приложения в Корзину и оставить приложение. При необходимости они создаются заново."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flytta appens %@ till papperskorgen och behåll appen. De skapas igen vid behov."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamanın şu öğelerini Çöp Sepetine taşır ve uygulamayı korur: %@. Gerektiğinde yeniden oluşturulurlar."
          }
        },
        "zh-Hans" : {
