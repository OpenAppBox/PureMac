    "Quit and reopen PureMac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ PureMac ثم أعد فتحه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut og åbn PureMac igen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende PureMac und öffne es erneut."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta PureMac ja avaa se uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez PureMac et rouvrez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudi e riapri PureMac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac を終了して、もう一度開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac을 종료했다가 다시 여십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt og åpne PureMac på nytt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop PureMac en open het opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ i ponownie otwórz PureMac."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre e reabra o PureMac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закройте и снова откройте PureMac."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta och öppna PureMac igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac’ten çıkar ve yeniden açar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请退出并重新打开 PureMac。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請結束並重新打開 PureMac。"
          }
        }
      }
    },
    "Quit first; running apps are skipped. PureMac asks them to quit normally and never force-quits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِها أولًا؛ تُتخطّى التطبيقات قيد التشغيل. يطلب PureMac منها الإنهاء بشكل طبيعي ولا يفرض الإنهاء أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut først; åbne apps springes over. PureMac beder dem afslutte normalt og tvangsafslutter aldrig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erst beenden; geöffnete Apps werden übersprungen. PureMac bittet sie, sich normal zu beenden, und erzwingt das nie."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta ensin; käynnissä olevat apit ohitetaan. PureMac pyytää niitä lopettamaan normaalisti eikä koskaan pakota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez d’abord ; les apps ouvertes sont ignorées. PureMac leur demande de quitter normalement et ne force jamais."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima chiudi; le app aperte vengono saltate. PureMac chiede loro di chiudersi normalmente e non forza mai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先に終了してください。起動中のアプリはスキップされます。PureMac は通常どおり終了するよう依頼し、強制終了はしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 종료하십시오. 실행 중인 앱은 건너뜁니다. PureMac은 정상적으로 종료하도록 요청하며 강제 종료하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt først; åpne apper hoppes over. PureMac ber dem avslutte normalt og tvangsavslutter aldri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop eerst; geopende apps worden overgeslagen. PureMac vraagt ze normaal te stoppen en dwingt dat nooit af."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najpierw zakończ; otwarte aplikacje są pomijane. PureMac prosi je o normalne zakończenie i nigdy go nie wymusza."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre primeiro; apps abertos são ignorados. O PureMac pede que encerrem normalmente e nunca força o encerramento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сначала завершите; открытые приложения пропускаются. PureMac просит их завершиться обычным образом и никогда не делает этого принудительно."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta först; öppna appar hoppas över. PureMac ber dem avsluta normalt och tvångsavslutar aldrig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Önce uygulamalardan çıkın; çalışan uygulamalar atlanır. PureMac onlardan normal şekilde çıkmalarını ister, asla zorla kapatmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先退出；正在运行的应用会被跳过。PureMac 会请它们正常退出，从不强制退出。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先結束；正在執行的 App 會被略過。PureMac 會要求它們正常結束，絕不強制結束。"
          }
        }
      }
    },
    "Quit it before removing it or its data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِه قبل إزالته أو إزالة بياناته."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afslut den, før du fjerner den eller dens data."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beende sie, bevor du sie oder ihre Daten entfernst."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lopeta se ennen sen tai sen tietojen poistamista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quittez-la avant de la supprimer ou de supprimer ses données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiudila prima di rimuovere l’app o i suoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリやそのデータを削除する前に、アプリを終了してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이나 그 데이터를 제거하기 전에 앱을 종료하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt den før du fjerner den eller dataene dens."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stop de app voordat je hem of zijn gegevens verwijdert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończ ją przed usunięciem jej lub jej danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encerre-o antes de removê-lo ou remover os dados dele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завершите его, прежде чем удалять его или его данные."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avsluta den innan du tar bort den eller dess data."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamayı veya verilerini kaldırmadan önce uygulamadan çıkın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在移除应用或其数据之前，请先退出应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在移除 App 或其資料之前，請先結束 App。"
          }
        }
      }
    },
