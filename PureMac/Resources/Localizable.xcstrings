            "value" : "Résidente"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wired"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "固定"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "고정 메모리"
          }
        },
        "nb" : {
