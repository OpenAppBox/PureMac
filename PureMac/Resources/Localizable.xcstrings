        }
      }
    },
    "There is deliberately no “always clean automatically” option." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوجد عمدًا خيار «التنظيف التلقائي دائمًا»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der er bevidst ingen mulighed for “ryd altid automatisk op”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Option „immer automatisch bereinigen“ gibt es bewusst nicht."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaihtoehtoa ”siivoa aina automaattisesti” ei ole tarkoituksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe volontairement aucune option « toujours nettoyer automatiquement »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di proposito non esiste un’opzione “pulisci sempre automaticamente”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「常に自動でクリーンアップ」というオプションはあえて用意していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“항상 자동으로 정리” 옵션은 의도적으로 제공하지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finnes bevisst ikke noe valg for «rydd alltid automatisk»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er is bewust geen optie ‘altijd automatisch opschonen’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celowo nie ma opcji „zawsze czyść automatycznie”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe, de propósito, uma opção “sempre limpar automaticamente”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Варианта «всегда очищать автоматически» намеренно нет."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det finns medvetet inget alternativ för ”rensa alltid automatiskt”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilinçli olarak “her zaman otomatik temizle” seçeneği yoktur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们特意没有提供“始终自动清理”选项。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們刻意不提供「一律自動清理」選項。"
          }
        }
      }
    },
