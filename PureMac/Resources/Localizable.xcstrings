    "These locations were not measured. Their sizes are not part of any total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُقس هذه المواقع. أحجامها ليست جزءًا من أي إجمالي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disse steder blev ikke målt. Deres størrelser indgår ikke i nogen total."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Orte wurden nicht gemessen. Ihre Größen sind in keiner Summe enthalten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näitä sijainteja ei mitattu. Niiden koot eivät sisälly mihinkään summaan."
