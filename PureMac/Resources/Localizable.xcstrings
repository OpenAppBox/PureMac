    "Chooses one copy to keep in every listed file and selects the rest. Review before anything moves." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يختار نسخة واحدة للاحتفاظ بها من كل ملف مدرج ويحدد البقية. راجِع قبل نقل أي شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælger én kopi at beholde for hver fil på listen og vælger resten. Du gennemgår alt, før noget flyttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählt bei jeder aufgeführten Datei eine Kopie zum Behalten und markiert die übrigen. Du prüfst alles, bevor etwas verschoben wird."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitsee säilytettävän kopion jokaiselle luetellulle tiedostolle ja valitsee muut. Tarkistat ennen kuin mitään siirretään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisit une copie à garder pour chaque fichier listé et sélectionne les autres. Vous vérifiez avant tout déplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sceglie una copia da tenere per ogni file elencato e seleziona le altre. Controlli tutto prima che qualcosa venga spostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一覧の各ファイルで保持するコピーを 1 つ選び、残りを選択します。移動の前に必ず確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "목록의 모든 파일에서 유지할 사본 하나를 고르고 나머지를 선택합니다. 이동하기 전에 검토하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velger én kopi å beholde for hver fil i listen og velger resten. Du går gjennom alt før noe flyttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiest per vermeld bestand één kopie om te bewaren en selecteert de rest. Je controleert alles voordat er iets wordt verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybiera po jednej kopii do zachowania dla każdego pliku z listy i zaznacza pozostałe. Przed przeniesieniem wszystko sprawdzasz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe uma cópia para manter em cada arquivo listado e seleciona as demais. Revise antes de qualquer coisa ser movida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирает одну копию для сохранения у каждого файла в списке и отмечает остальные. Перед перемещением вы всё проверите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väljer en kopia att behålla för varje fil i listan och markerar resten. Du granskar innan något flyttas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Listelenen her dosya için korunacak bir kopya belirler ve geri kalanları seçer. Hiçbir şey taşınmadan önce incelersiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为列表中的每个文件选择一个要保留的副本，并选中其余副本。移动任何内容之前请先检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為列表中的每個檔案選擇一個要保留的副本，並選取其餘副本。搬移任何內容之前請先檢查。"
          }
        }
      }
    },
