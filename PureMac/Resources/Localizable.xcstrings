    "Wait for the scan or cleanup to finish." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر حتى ينتهي الفحص أو التنظيف."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vent, til scanningen eller oprydningen er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Warte, bis der Scan oder die Bereinigung fertig ist."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odota, että skannaus tai siivous valmistuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez la fin de l’analyse ou du nettoyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendi la fine dell’analisi o della pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンまたはクリーンアップが終わるまでお待ちください。"
