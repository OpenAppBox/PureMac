          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح مراجعة لما سيُنقل بالضبط إلى سلة المهملات (⌘⌫). لا يُزال شيء حتى تؤكد."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åbner en gennemgang af præcis, hvad der flyttes til papirkurven (⌘⌫). Intet fjernes, før du bekræfter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet eine Prüfung dessen, was genau in den Papierkorb kommt (⌘⌫). Nichts wird entfernt, bevor du bestätigst."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa tarkistuksen siitä, mitä tarkalleen siirretään roskakoriin (⌘⌫). Mitään ei poisteta ennen vahvistustasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre une vérification de ce qui va exactement dans la Corbeille (⌘⌫). Rien n’est supprimé avant votre confirmation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre un controllo di cosa esattamente finirà nel Cestino (⌘⌫). Nulla viene rimosso finché non confermi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゴミ箱に入れるものを正確に確認する画面を開きます（⌘⌫）。確定するまで何も削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴지통으로 이동할 항목을 정확히 검토하는 화면을 엽니다(⌘⌫). 확인하기 전까지 아무것도 제거되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Åpner en gjennomgang av nøyaktig hva som flyttes til papirkurven (⌘⌫). Ingenting fjernes før du bekrefter."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent een controle van precies wat naar de prullenmand gaat (⌘⌫). Er wordt niets verwijderd tot je bevestigt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwiera sprawdzenie dokładnie tego, co trafi do kosza (⌘⌫). Nic nie jest usuwane bez Twojego potwierdzenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre uma revisão exata do que irá para o Lixo (⌘⌫). Nada é removido até você confirmar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает проверку того, что именно попадёт в Корзину (⌘⌫). Ничего не удаляется до вашего подтверждения."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öppnar en granskning av exakt vad som flyttas till papperskorgen (⌘⌫). Inget tas bort förrän du bekräftar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepetine tam olarak nelerin taşınacağını gösteren incelemeyi açar (⌘⌫). Siz onaylayana kadar hiçbir şey kaldırılmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开即将移到废纸篓的内容的确切清单（⌘⌫）。确认前不会移除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打開即將移到垃圾桶的內容的確切清單（⌘⌫）。確認前不會移除任何內容。"
          }
        }
      }
    },
