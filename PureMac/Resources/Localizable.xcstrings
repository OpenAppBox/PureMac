                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld عنصر تعيد تطبيقاتك وأدواتك إنشاءها بنفسها. ينتقل كل شيء إلى سلة المهملات أولًا، وترى القائمة كاملة قبل نقل أي شيء."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld عنصر تعيد تطبيقاتك وأدواتك إنشاءها بنفسها. ينتقل كل شيء إلى سلة المهملات أولًا، وترى القائمة كاملة قبل نقل أي شيء."
                }
              },
