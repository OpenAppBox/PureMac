    "Byte-identical files, compared by size, fingerprint and SHA-256. One copy is always kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملفات متطابقة بايتًا ببايت، تمت مقارنتها بالحجم والبصمة وSHA-256. يُحتفظ دائمًا بنسخة واحدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer, der er identiske byte for byte, sammenlignet efter størrelse, fingeraftryk og SHA-256. Én kopi beholdes altid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byte-identische Dateien, verglichen nach Größe, Fingerabdruck und SHA-256. Eine Kopie bleibt immer erhalten."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tavu tavulta identtiset tiedostot, verrattu koon, sormenjäljen ja SHA-256:n perusteella. Yksi kopio säilytetään aina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fichiers identiques octet par octet, comparés par taille, empreinte et SHA-256. Une copie est toujours conservée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "File identici byte per byte, confrontati per dimensioni, impronta e SHA-256. Una copia viene sempre mantenuta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サイズ、フィンガープリント、SHA-256 で比較したバイト単位で同一のファイルです。コピーは必ず 1 つ保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "크기, 지문, SHA-256으로 비교한 바이트 단위로 동일한 파일입니다. 사본 하나는 항상 유지됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filer som er identiske byte for byte, sammenlignet etter størrelse, fingeravtrykk og SHA-256. Én kopi beholdes alltid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byte voor byte identieke bestanden, vergeleken op grootte, vingerafdruk en SHA-256. Er blijft altijd één kopie bewaard."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pliki identyczne co do bajtu, porównywane według rozmiaru, odcisku i SHA-256. Jedna kopia jest zawsze zachowywana."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos idênticos byte a byte, comparados por tamanho, impressão digital e SHA-256. Uma cópia é sempre mantida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Побайтово одинаковые файлы, сравнённые по размеру, отпечатку и SHA-256. Одна копия всегда сохраняется."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Byte för byte identiska filer, jämförda på storlek, fingeravtryck och SHA-256. En kopia behålls alltid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Boyut, parmak izi ve SHA-256 ile karşılaştırılan, bayt bayt aynı dosyalar. Bir kopya her zaman korunur."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐字节相同的文件，按大小、指纹和 SHA-256 比较。始终保留一个副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "逐位元組相同的檔案，依大小、指紋和 SHA-256 比較。一律保留一個副本。"
          }
        }
      }
    },
