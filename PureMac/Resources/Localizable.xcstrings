    "Adds these items to the review. You still see every item before anything moves." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف هذه العناصر إلى المراجعة. سترى كل عنصر قبل نقل أي شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Føjer emnerne til gennemgangen. Du ser stadig hvert emne, før noget flyttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt diese Objekte zur Prüfung hinzu. Du siehst trotzdem jedes Objekt, bevor etwas verschoben wird."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kohteet tarkistukseen. Näet silti jokaisen kohteen ennen kuin mitään siirretään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute ces éléments à la vérification. Vous voyez chaque élément avant tout déplacement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge questi elementi alla verifica. Vedi comunque ogni elemento prima che venga spostato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらの項目を確認に追加します。移動する前に必ずすべての項目を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 항목을 검토에 추가합니다. 이동하기 전에 모든 항목을 확인할 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legger objektene til i gjennomgangen. Du ser fortsatt hvert objekt før noe flyttes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voegt deze onderdelen toe aan de controle. Je ziet elk onderdeel nog voordat er iets wordt verplaatst."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaje te elementy do przeglądu. I tak zobaczysz każdy element przed przeniesieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona estes itens à revisão. Você ainda vê cada item antes de qualquer movimentação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляет эти объекты к проверке. Вы всё равно увидите каждый объект перед перемещением."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägger till objekten i granskningen. Du ser fortfarande varje objekt innan något flyttas."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu öğeleri incelemeye ekler. Bir şey taşınmadan önce her öğeyi yine görürsünüz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将这些项目加入检查。移动任何内容之前，你仍会看到每个项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將這些項目加入檢查。搬移任何內容之前，你仍會看到每個項目。"
          }
        }
      }
    },
