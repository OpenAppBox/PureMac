    "Space returns when you empty the Trash. PureMac never empties it for you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود المساحة عند إفراغ سلة المهملات. لا يفرغها PureMac نيابةً عنك أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pladsen kommer tilbage, når du tømmer papirkurven. PureMac tømmer den aldrig for dig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Platz wird frei, wenn du den Papierkorb entleerst. PureMac entleert ihn nie für dich."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tila palautuu, kun tyhjennät roskakorin. PureMac ei koskaan tyhjennä sitä puolestasi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’espace est rendu quand vous videz la Corbeille. PureMac ne la vide jamais pour vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo spazio torna quando svuoti il Cestino. PureMac non lo svuota mai al posto tuo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "容量はゴミ箱を空にすると戻ります。PureMac がゴミ箱を空にすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공간은 휴지통을 비우면 돌아옵니다. PureMac은 휴지통을 비우지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plassen kommer tilbake når du tømmer papirkurven. PureMac tømmer den aldri for deg."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruimte komt terug als je de prullenmand leegmaakt. PureMac maakt hem nooit voor je leeg."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Miejsce wróci po opróżnieniu kosza. PureMac nigdy go nie opróżnia za Ciebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espaço volta quando você esvazia o Lixo. O PureMac nunca o esvazia por você."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Место вернётся, когда вы очистите Корзину. PureMac никогда не очищает её за вас."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utrymmet kommer tillbaka när du tömmer papperskorgen. PureMac tömmer den aldrig åt dig."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alan, Çöp Sepetini boşalttığınızda geri gelir. PureMac sepeti asla sizin yerinize boşaltmaz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清倒废纸篓后空间才会回来。PureMac 从不替你清倒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清空垃圾桶後空間才會回來。PureMac 絕不會幫你清空。"
          }
        }
      }
    },
