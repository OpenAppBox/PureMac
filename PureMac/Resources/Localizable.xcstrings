    "Decimal units match Finder and the storage sizes Apple advertises." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تطابق الوحدات العشرية Finder وأحجام التخزين التي تعلنها Apple."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decimale enheder svarer til Finder og de lagerstørrelser, Apple angiver."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dezimale Einheiten entsprechen dem Finder und den von Apple angegebenen Speichergrößen."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desimaaliyksiköt vastaavat Finderia ja Applen ilmoittamia tallennustilan kokoja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les unités décimales correspondent au Finder et aux capacités annoncées par Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le unità decimali corrispondono al Finder e alle capacità dichiarate da Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "10 進単位は Finder や Apple が公表するストレージ容量と一致します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "십진 단위는 Finder 및 Apple이 표기하는 저장 공간 크기와 같습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desimale enheter samsvarer med Finder og lagringsstørrelsene Apple oppgir."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decimale eenheden komen overeen met de Finder en de opslagcapaciteit die Apple opgeeft."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jednostki dziesiętne odpowiadają Finderowi i pojemnościom podawanym przez Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As unidades decimais correspondem ao Finder e às capacidades anunciadas pela Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Десятичные единицы совпадают с Finder и объёмами, которые указывает Apple."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decimala enheter stämmer med Finder och de lagringsstorlekar Apple anger."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ondalık birimler Finder ile ve Apple’ın belirttiği depolama boyutlarıyla aynıdır."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十进制单位与访达和 Apple 标示的存储容量一致。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "十進位單位與 Finder 及 Apple 標示的儲存容量一致。"
          }
        }
      }
    },
