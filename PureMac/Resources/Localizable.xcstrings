    "Add a folder PureMac should skip, or right-click an item on any page and choose “Exclude”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف مجلدًا ليتخطاه PureMac، أو انقر بزر الماوس الأيمن على عنصر في أي صفحة واختر «استثناء»."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tilføj en mappe, som PureMac skal springe over, eller højreklik på et emne på en vilkårlig side, og vælg “Udelad”."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge einen Ordner hinzu, den PureMac überspringen soll, oder klicke auf einer beliebigen Seite mit der rechten Maustaste auf ein Objekt und wähle „Ausschließen“."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lisää kansio, jonka PureMac ohittaa, tai napsauta kohdetta oikealla millä tahansa sivulla ja valitse ”Jätä pois”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez un dossier que PureMac doit ignorer, ou faites un clic droit sur un élément dans n’importe quelle page et choisissez « Exclure »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi una cartella che PureMac deve ignorare, oppure fai clic destro su un elemento in qualsiasi pagina e scegli “Escludi”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac にスキップさせるフォルダを追加するか、任意のページで項目を右クリックして「除外」を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac이 건너뛸 폴더를 추가하거나, 아무 페이지에서나 항목을 오른쪽 클릭하고 “제외”를 선택하십시오."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legg til en mappe PureMac skal hoppe over, eller høyreklikk på et objekt på en hvilken som helst side og velg «Utelat»."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg een map toe die PureMac moet overslaan, of klik met de rechtermuisknop op een onderdeel op een willekeurige pagina en kies ‘Uitsluiten’."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj folder, który PureMac ma pomijać, lub kliknij prawym przyciskiem element na dowolnej stronie i wybierz „Wyklucz”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione uma pasta que o PureMac deve ignorar, ou clique com o botão direito em um item de qualquer página e escolha “Ignorar”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте папку, которую PureMac должен пропускать, или нажмите правой кнопкой на объект на любой странице и выберите «Исключить»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lägg till en mapp som PureMac ska hoppa över, eller högerklicka på ett objekt på valfri sida och välj ”Uteslut”."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac’in atlaması gereken bir klasör ekleyin ya da herhangi bir sayfada bir öğeye sağ tıklayıp “Hariç Tut”u seçin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加 PureMac 应跳过的文件夹，或在任意页面上右键点按项目并选择“排除”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加入 PureMac 應略過的檔案夾，或在任一頁面上按右鍵點選項目並選擇「排除」。"
          }
        }
      }
    },
