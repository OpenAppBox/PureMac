    "Large personal files are never selected for cleanup automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تُحدَّد الملفات الشخصية الكبيرة للتنظيف تلقائيًا أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store personlige filer vælges aldrig automatisk til oprydning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Große persönliche Dateien werden nie automatisch zur Bereinigung ausgewählt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suuria henkilökohtaisia tiedostoja ei koskaan valita siivottaviksi automaattisesti."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les gros fichiers personnels ne sont jamais sélectionnés automatiquement pour le nettoyage."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file personali di grandi dimensioni non vengono mai selezionati automaticamente per la pulizia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大きな個人ファイルがクリーンアップ対象として自動的に選ばれることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "큰 개인 파일은 정리 대상으로 자동 선택되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Store personlige filer velges aldri automatisk for rydding."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grote persoonlijke bestanden worden nooit automatisch geselecteerd voor opschonen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duże pliki osobiste nigdy nie są automatycznie zaznaczane do czyszczenia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arquivos pessoais grandes nunca são selecionados automaticamente para limpeza."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крупные личные файлы никогда не выбираются для очистки автоматически."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stora personliga filer markeras aldrig automatiskt för rensning."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büyük kişisel dosyalar temizlik için asla otomatik olarak seçilmez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大型个人文件永远不会被自动选中进行清理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大型個人檔案絕不會被自動選取進行清理。"
          }
        }
      }
    },
