    },
    "Choose “Applications” so PureMac can move apps you uninstall to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «التطبيقات» حتى يتمكن PureMac من نقل التطبيقات التي تلغي تثبيتها إلى سلة المهملات."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg „Programmer“, så PureMac kan flytte apps, du afinstallerer, til papirkurven."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle „Programme“, damit PureMac deinstallierte Apps in den Papierkorb legen kann."
          }
        },
        "fi" : {
