          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A localização no Lixo não foi registrada. Use Colocar de Volta no Lixo do Finder."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расположение в Корзине не записано. Используйте «Восстановить» в Корзине Finder."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platsen i papperskorgen registrerades inte. Använd Lägg tillbaka i Finders papperskorg."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çöp Sepeti’ndeki konumu kaydedilmedi. Finder’daki Çöp Sepeti’nde Yerine Koy’u kullanın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未记录它在废纸篓中的位置。请在访达的废纸篓中使用“放回原处”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未記錄它在垃圾桶中的位置。請在 Finder 的垃圾桶中使用「還原」。"
          }
        }
      }
    },
    "Its logical size is much larger than the space it uses on disk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حجمه المنطقي أكبر بكثير من المساحة التي يشغلها على القرص."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dens logiske størrelse er meget større end den plads, den bruger på disken."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seine logische Größe ist viel größer als der Platz, den es auf dem Volume belegt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sen looginen koko on paljon suurempi kuin sen levyllä viemä tila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sa taille logique est bien supérieure à l’espace qu’il occupe sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue dimensioni logiche sono molto maggiori dello spazio che occupa su disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "論理サイズが、ディスク上で使っている容量よりかなり大きくなっています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "논리적 크기가 디스크에서 실제로 사용하는 공간보다 훨씬 큽니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Den logiske størrelsen er mye større enn plassen den bruker på disken."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De logische grootte is veel groter dan de ruimte die het op schijf inneemt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jego rozmiar logiczny jest znacznie większy niż miejsce zajmowane na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O tamanho lógico é bem maior que o espaço que ele ocupa no disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Его логический размер намного больше места, которое он занимает на диске."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dess logiska storlek är mycket större än utrymmet det använder på skivan."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantıksal boyutu, diskte kullandığı alandan çok daha büyük."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其逻辑大小远大于它在磁盘上占用的空间。"
