    "Places PureMac skips when scanning or never proposes for cleanup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أماكن يتخطاها PureMac عند الفحص أو لا يقترحها للتنظيف أبدًا."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steder, PureMac springer over ved scanning eller aldrig foreslår til oprydning."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte, die PureMac beim Scannen überspringt oder nie zur Bereinigung vorschlägt."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paikat, jotka PureMac ohittaa skannauksessa tai joita se ei koskaan ehdota siivottaviksi."
          }
        },
        "fr" : {
          "stringUnit" : {
