    "Rank by" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الترتيب حسب"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ranger efter"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortieren nach"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Järjestä"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classer par"
          }
