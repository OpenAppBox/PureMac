    "Matching locations and measuring each candidate. Nothing is changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ مطابقة المواقع وقياس كل مرشّح. لا يتغير أي شيء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matcher steder og måler hver kandidat. Intet ændres."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orte werden abgeglichen und alle Kandidaten gemessen. Es wird nichts geändert."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etsitään sijainteja ja mitataan jokainen ehdokas. Mitään ei muuteta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recherche des emplacements et mesure de chaque candidat. Rien n’est modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbinamento delle posizioni e misurazione di ogni candidato. Non viene modificato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "場所を照合し、各候補を測定しています。何も変更されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 대조하고 각 후보를 측정하는 중입니다. 아무것도 변경되지 않습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sammenligner steder og måler hver kandidat. Ingenting endres."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Locaties worden gezocht en elke kandidaat wordt gemeten. Er wordt niets gewijzigd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopasowywanie lokalizacji i mierzenie każdego kandydata. Nic nie jest zmieniane."
          }
        },
