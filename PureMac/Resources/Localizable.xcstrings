          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용하지 않는 개발자 데이터"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubrukte utviklerdata"
          }
        },
