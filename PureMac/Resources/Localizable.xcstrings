    "Each completed scan adds a point here so you can see how your storage changes over time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف كل فحص مكتمل نقطة هنا لترى كيف يتغير التخزين بمرور الوقت."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver færdig scanning tilføjer et punkt her, så du kan se, hvordan dit lager ændrer sig over tid."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder abgeschlossene Scan fügt hier einen Punkt hinzu, damit du siehst, wie sich dein Speicher über die Zeit verändert."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jokainen valmis skannaus lisää tähän pisteen, jotta näet, miten tallennustila muuttuu ajan myötä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque analyse terminée ajoute un point ici pour voir l’évolution de votre stockage dans le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni analisi completata aggiunge qui un punto, così vedi come cambia il tuo spazio nel tempo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキャンが完了するたびにここに点が追加され、ストレージの推移を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스캔을 완료할 때마다 여기에 점이 추가되어 저장 공간의 변화를 볼 수 있습니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hver fullførte skanning legger til et punkt her, slik at du ser hvordan lagringen endrer seg over tid."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke voltooide scan voegt hier een punt toe, zodat je ziet hoe je opslag in de loop van de tijd verandert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy ukończony skan dodaje tu punkt, abyś widział, jak pamięć zmienia się w czasie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada análise concluída adiciona um ponto aqui para você ver como seu armazenamento muda com o tempo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждое завершённое сканирование добавляет сюда точку, чтобы было видно, как меняется хранилище со временем."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje slutförd skanning lägger till en punkt här så att du ser hur lagringen förändras över tid."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamamlanan her tarama buraya bir nokta ekler; böylece depolamanızın zaman içinde nasıl değiştiğini görebilirsiniz."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次完成扫描都会在此添加一个点，让你看到存储随时间的变化。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次完成掃描都會在此加入一個點，讓你看到儲存空間隨時間的變化。"
          }
        }
      }
    },
    "Each is your call — one tap adds it to the review" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القرار لك — نقرة واحدة تضيفه إلى المراجعة"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bestemmer – ét klik føjer det til gennemgangen"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du entscheidest – ein Klick fügt es zur Prüfung hinzu"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinä päätät – yksi napsautus lisää sen tarkistukseen"
          }
        },
        "fr" : {
          "stringUnit" : {
