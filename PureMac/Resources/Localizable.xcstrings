    "%lld items (%@) are held back because their apps are running. Quit them and PureMac checks again by itself." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تعليق %lld عنصر (%@) لأن تطبيقاتها قيد التشغيل. أنهِها وسيعيد PureMac التحقق من تلقاء نفسه."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld emner (%@) holdes tilbage, fordi deres apps er åbne. Afslut dem, så tjekker PureMac igen af sig selv."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld Objekte (%@) werden zurückgehalten, weil ihre Apps geöffnet sind. Beende sie, dann prüft PureMac von selbst erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$lld items (%2$@) are held back because their apps are running. Quit them and PureMac checks again by itself."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld kohdetta (%@) pidätetään, koska niiden apit ovat käynnissä. Lopeta ne, niin PureMac tarkistaa uudelleen itsestään."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld éléments (%@) sont mis de côté car leurs apps sont ouvertes. Quittez-les et PureMac revérifie de lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld elementi (%@) sono trattenuti perché le loro app sono aperte. Chiudile e PureMac ricontrolla da solo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld 項目（%@）は、アプリが起動中のため保留されています。アプリを終了すると PureMac が自動的に再確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱이 실행 중이므로 항목 %lld개(%@)가 보류되었습니다. 앱을 종료하면 PureMac이 자동으로 다시 확인합니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld objekter (%@) holdes tilbake fordi appene deres er åpne. Avslutt dem, så sjekker PureMac på nytt av seg selv."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld onderdelen (%@) worden tegengehouden omdat hun apps geopend zijn. Stop ze en PureMac controleert zelf opnieuw."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wstrzymane elementy: %lld (%@), bo ich aplikacje są otwarte. Zamknij je, a PureMac sam sprawdzi ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld itens (%@) estão retidos porque seus apps estão abertos. Encerre-os e o PureMac verifica de novo sozinho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объектов отложено: %lld (%@), потому что их приложения открыты. Закройте их, и PureMac проверит снова сам."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld objekt (%@) hålls kvar eftersom deras appar är öppna. Avsluta dem så kontrollerar PureMac igen av sig själv."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamaları çalıştığı için %1$lld öğe (%2$@) bekletiliyor. Uygulamalardan çıktığınızda PureMac kendiliğinden yeniden denetler."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由于相关应用正在运行，%lld 个项目（%@）被暂缓。退出这些应用后，PureMac 会自动重新检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "由於相關 App 正在執行，%lld 個項目（%@）暫緩處理。結束這些 App 後，PureMac 會自動重新檢查。"
          }
        }
      }
    },
