        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "선택은 사용자에게 — 한 번 탭하면 검토에 추가됩니다"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
