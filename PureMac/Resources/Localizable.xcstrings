          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac がスキャンでスキップする場所、またはクリーンアップに提案しない場所。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PureMac이 스캔 시 건너뛰거나 정리 대상으로 제안하지 않는 위치."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steder PureMac hopper over ved skanning eller aldri foreslår for opprydding."
